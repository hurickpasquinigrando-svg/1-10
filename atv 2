programa
{
    funcao inicio()
    {
        real A = 80000
        real B = 200000
        inteiro anos = 0

        enquanto (A < B)
        {
            A = A * 1.03
            B = B * 1.015
            anos = anos + 1
        }

        escreva("Serão necessários ", anos, " anos.\n")
        escreva("População de A: ", A, "\n")
        escreva("População de B: ", B, "\n")
    }
}
