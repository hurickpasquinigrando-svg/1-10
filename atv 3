programa
{
    funcao inicio()
    {
        real n1, n2, n3, n4, n5
        real soma, media

        escreva("Digite o primeiro número: ")
        leia(n1)

        escreva("Digite o segundo número: ")
        leia(n2)

        escreva("Digite o terceiro número: ")
        leia(n3)

        escreva("Digite o quarto número: ")
        leia(n4)

        escreva("Digite o quinto número: ")
        leia(n5)

        soma = n1 + n2 + n3 + n4 + n5
        media = soma / 5

        escreva("Soma: ", soma, "\n")
        escreva("Média: ", media, "\n")
    }
}
