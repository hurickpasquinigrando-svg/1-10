programa
{
    funcao inicio()
    {
        inteiro numero
        inteiro pares = 0
        inteiro impares = 0
        inteiro i

        para (i = 1; i <= 5; i++)
        {
            escreva("Digite um número inteiro: ")
            leia(numero)

            se (numero % 2 == 0)
            {
                pares = pares + 1
            }
            senao
            {
                impares = impares + 1
            }
        }

        escreva("Quantidade de números pares: ", pares, "\n")
        escreva("Quantidade de números ímpares: ", impares, "\n")
    }
}
