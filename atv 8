programa
{
    funcao inicio()
    {
        inteiro numero
        inteiro fatorial = 1
        inteiro i = 1

        escreva("Digite um número inteiro: ")
        leia(numero)

        enquanto (i <= numero)
        {
            fatorial = fatorial * i
            i = i + 1
        }

        escreva("O fatorial de ", numero, " é: ", fatorial)
    }
}
